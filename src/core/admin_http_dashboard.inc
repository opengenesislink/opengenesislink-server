std::string dashboard_html() {
return R"HTML(<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OpenGenesisLINK Core</title><style>
:root{color-scheme:dark;background:#070a11;color:#e8eef8;font:14px system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0,#172745 0,#070a11 44%);min-height:100vh}.wrap{max-width:1220px;margin:auto;padding:32px 20px 64px}h1{margin:0;font-size:25px}.sub{color:#8d9ab1;margin-top:5px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:11px;margin:26px 0}.card,.panel{background:#101722d9;border:1px solid #283751;border-radius:14px}.card{padding:16px}.label{font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:#91a0b7}.value{font-size:25px;font-weight:750;margin-top:7px}.panel{padding:18px;margin:13px 0;overflow:auto}h2{font-size:16px;margin:0 0 13px}table{width:100%;border-collapse:collapse;min-width:720px}th,td{text-align:left;padding:9px;border-bottom:1px solid #202d41;font-size:13px}th{color:#92a2ba}.online{color:#6ee7a2}.offline{color:#ff8d8d}.api{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:8px}.endpoint{padding:9px 11px;background:#0a101a;border:1px solid #23314a;border-radius:9px;font-family:ui-monospace,monospace}.method{color:#6ee7a2;margin-right:8px}a{color:#8ec0ff;text-decoration:none}.foot{color:#748198;font-size:12px;margin-top:22px}</style></head><body><div class="wrap"><h1>OpenGenesisLINK Core</h1><div class="sub">C++23 · 4.0.0-dev · Avatar runtime · HG Friends/Assets · OGL-FED</div>
<div class="grid"><div class="card"><div class="label">Version</div><div class="value" id="version">—</div></div><div class="card"><div class="label">Uptime</div><div class="value" id="uptime">—</div></div><div class="card"><div class="label">World / Regions</div><div class="value" id="world">—</div></div><div class="card"><div class="label">Avatars</div><div class="value" id="avatars">—</div></div><div class="card"><div class="label">Users / Sessions</div><div class="value" id="identity">—</div></div><div class="card"><div class="label">Assets / Inventory</div><div class="value" id="content">—</div></div><div class="card"><div class="label">Presence</div><div class="value" id="presence">—</div></div><div class="card"><div class="label">Social / Notifications</div><div class="value" id="social">—</div></div><div class="card"><div class="label">Groups / Parcels / Estates</div><div class="value" id="governance">—</div></div><div class="card"><div class="label">Bans / Audit</div><div class="value" id="safety">—</div></div></div>
<div class="panel"><h2>Regions</h2><table><thead><tr><th>Region</th><th>State</th><th>Grid</th><th>FPS</th><th>Entities</th><th>Avatars</th><th>Physics</th><th>Terrain</th></tr></thead><tbody id="regions"></tbody></table></div>
<div class="panel"><h2>World Nodes</h2><table><thead><tr><th>Node</th><th>State</th><th>Scene Endpoint</th><th>Generation</th></tr></thead><tbody id="worlds"></tbody></table></div>
<div class="panel"><h2>API</h2><div class="api"><div class="endpoint"><span class="method">GET</span><a href="/v1">/v1</a></div><div class="endpoint"><span class="method">GET</span><a href="/v1/status">/v1/status</a></div><div class="endpoint"><span class="method">POST</span>/v1/viewer/session</div><div class="endpoint"><span class="method">POST</span>/v1/viewer/teleport</div><div class="endpoint"><span class="method">POST</span>/v1/viewer/handoff</div><div class="endpoint"><span class="method">GET</span>/v1/presence</div><div class="endpoint"><span class="method">GET/POST</span>/v1/groups</div><div class="endpoint"><span class="method">GET</span>/v1/parcels/owned</div><div class="endpoint"><span class="method">GET/POST</span>/v1/estates</div><div class="endpoint"><span class="method">GET/POST</span>/v1/landmarks</div><div class="endpoint"><span class="method">GET</span>/v1/notifications</div><div class="endpoint"><span class="method">GET/POST</span>/v1/groups/{id}/channel</div><div class="endpoint"><span class="method">GET</span><a href="/metrics">/metrics</a></div><div class="endpoint"><span class="method">GET</span>/v1/social/friends</div><div class="endpoint"><span class="method">GET/POST</span>/v1/social/messages</div><div class="endpoint"><span class="method">GET</span>/v1/inventory</div><div class="endpoint"><span class="method">GET/POST</span>/v1/assets</div><div class="endpoint"><span class="method">GET</span><a href="/v1/content/stats">/v1/content/stats</a></div><div class="endpoint"><span class="method">POST</span>/v1/auth/login</div><div class="endpoint"><span class="method">GET</span>/v1/auth/me</div><div class="endpoint"><span class="method">ADMIN</span>/v1/admin/moderation</div><div class="endpoint"><span class="method">ADMIN</span>/v1/admin/audit</div></div></div>
<div class="foot">Development interface. Scene access uses short-lived Core-signed tickets with explicit capabilities. Avatar movement, estates, parcels, social/group channels, landmarks, teleport/handoff, notifications and moderation are active development surfaces. Keep listeners on trusted interfaces until TLS, key rotation and production authorization are finalized.</div></div><script>
const e=id=>document.getElementById(id),cls=s=>s==='online'?'online':'offline';async function refresh(){try{const[s,i,c]=await Promise.all([fetch('/v1/status').then(r=>r.json()),fetch('/v1/identity/stats').then(r=>r.json()),fetch('/v1/content/stats').then(r=>r.json())]);e('version').textContent=s.version+'-dev';e('uptime').textContent=s.uptime_seconds+'s';e('world').textContent=s.world_nodes.length+' / '+s.regions.length;e('avatars').textContent=s.regions.reduce((a,r)=>a+r.avatars,0);e('identity').textContent=i.users+' / '+i.active_sessions;e('content').textContent=c.assets+' / '+c.inventory_items;e('presence').textContent=s.online_presences;e('social').textContent=s.messages+' / '+s.notifications;e('governance').textContent=s.groups+' / '+s.parcels+' / '+s.estates;e('safety').textContent=s.active_bans+' / '+s.audit_events;e('regions').innerHTML=s.regions.map(r=>`<tr><td>${r.name}<br><small>${r.id}</small></td><td class="${cls(r.state)}">${r.state}</td><td>${r.grid_x}, ${r.grid_y}</td><td>${Number(r.sim_fps).toFixed(1)}</td><td>${r.entities}</td><td>${r.avatars}</td><td>${r.physics_bodies}</td><td>${r.terrain_revision}</td></tr>`).join('');e('worlds').innerHTML=s.world_nodes.map(w=>`<tr><td>${w.name}<br><small>${w.id}</small></td><td class="${cls(w.state)}">${w.state}</td><td>${w.endpoint}</td><td>${w.generation}</td></tr>`).join('')}catch(x){console.error(x)}}refresh();setInterval(refresh,2000);
</script></body></html>)HTML";
