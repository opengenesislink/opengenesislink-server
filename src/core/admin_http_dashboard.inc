std::string dashboard_html() {
    return R"HTML(<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>OpenGenesisLINK Core</title>
<style>
:root{color-scheme:dark;background:#080b12;color:#e7edf7;font:15px system-ui,-apple-system,Segoe UI,sans-serif}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0,#17213b 0,#080b12 42%);min-height:100vh}.wrap{max-width:1180px;margin:auto;padding:34px 22px 70px}.brand{display:flex;align-items:center;gap:14px}.mark{width:46px;height:46px;border:1px solid #6da7ff;border-radius:13px;display:grid;place-items:center;box-shadow:0 0 30px #356dca55;font-weight:800;color:#8ec0ff}h1{font-size:24px;margin:0}.sub{color:#8e9bb1;margin-top:4px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:28px 0}.card,.panel{background:#101623cc;border:1px solid #26344e;border-radius:14px;box-shadow:0 14px 40px #0004}.card{padding:17px}.value{font-size:27px;font-weight:750;margin-top:7px}.label{color:#91a0b7;font-size:12px;text-transform:uppercase;letter-spacing:.08em}.panel{padding:18px;margin-top:14px;overflow:auto}h2{font-size:16px;margin:0 0 14px}table{width:100%;border-collapse:collapse;min-width:700px}th,td{text-align:left;padding:10px;border-bottom:1px solid #202c40;font-size:13px}th{color:#8fa0b9}.online{color:#6ee7a2}.offline{color:#ff9090}.api{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:8px}.endpoint{padding:10px 12px;background:#0a101b;border:1px solid #22304a;border-radius:9px;font-family:ui-monospace,monospace}.method{color:#6ee7a2;margin-right:8px}a{color:#8ec0ff;text-decoration:none}.foot{color:#6f7c90;margin-top:24px;font-size:12px}</style></head>
<body><div class="wrap"><div class="brand"><div class="mark">OG</div><div><h1>OpenGenesisLINK Core</h1><div class="sub">C++23 virtual world runtime · live development interface</div></div></div>
<div class="grid"><div class="card"><div class="label">Version</div><div class="value" id="version">—</div></div><div class="card"><div class="label">Uptime</div><div class="value" id="uptime">—</div></div><div class="card"><div class="label">World Nodes</div><div class="value" id="worlds">—</div></div><div class="card"><div class="label">Regions</div><div class="value" id="regions">—</div></div><div class="card"><div class="label">Avatars</div><div class="value" id="avatars">—</div></div><div class="card"><div class="label">Identities / Sessions</div><div class="value" id="identity">—</div></div></div>
<div class="panel"><h2>Regions</h2><table><thead><tr><th>Region</th><th>State</th><th>Grid</th><th>FPS</th><th>Ticks</th><th>Entities</th><th>Avatars</th><th>Physics</th><th>Terrain rev.</th></tr></thead><tbody id="regionRows"></tbody></table></div>
<div class="panel"><h2>World Nodes</h2><table><thead><tr><th>Node</th><th>State</th><th>Endpoint</th><th>Generation</th></tr></thead><tbody id="worldRows"></tbody></table></div>
<div class="panel"><h2>API</h2><div class="api"><div class="endpoint"><span class="method">GET</span><a href="/health">/health</a></div><div class="endpoint"><span class="method">GET</span><a href="/v1">/v1</a></div><div class="endpoint"><span class="method">GET</span><a href="/v1/status">/v1/status</a></div><div class="endpoint"><span class="method">GET</span><a href="/v1/worlds">/v1/worlds</a></div><div class="endpoint"><span class="method">GET</span><a href="/v1/regions">/v1/regions</a></div><div class="endpoint"><span class="method">GET</span><a href="/v1/identity/stats">/v1/identity/stats</a></div><div class="endpoint"><span class="method">POST</span>/v1/auth/register</div><div class="endpoint"><span class="method">POST</span>/v1/auth/login</div><div class="endpoint"><span class="method">GET</span>/v1/auth/me</div></div></div>
<div class="foot">Development API. Authentication/TLS hardening is still in progress; keep the admin listener on a trusted interface.</div></div>
<script>
const cls=s=>s==='online'?'online':'offline';const el=id=>document.getElementById(id);
async function refresh(){try{const [s,i]=await Promise.all([fetch('/v1/status').then(r=>r.json()),fetch('/v1/identity/stats').then(r=>r.json())]);el('version').textContent=s.version+'-dev';el('uptime').textContent=s.uptime_seconds+'s';el('worlds').textContent=s.world_nodes.length;el('regions').textContent=s.regions.length;el('avatars').textContent=s.regions.reduce((a,r)=>a+r.avatars,0);el('identity').textContent=i.users+' / '+i.active_sessions;el('regionRows').innerHTML=s.regions.map(r=>`<tr><td>${r.name}<br><small>${r.id}</small></td><td class="${cls(r.state)}">${r.state}</td><td>${r.grid_x}, ${r.grid_y}</td><td>${Number(r.sim_fps).toFixed(1)}</td><td>${r.ticks}</td><td>${r.entities}</td><td>${r.avatars}</td><td>${r.physics_bodies}</td><td>${r.terrain_revision}</td></tr>`).join('');el('worldRows').innerHTML=s.world_nodes.map(w=>`<tr><td>${w.name}<br><small>${w.id}</small></td><td class="${cls(w.state)}">${w.state}</td><td>${w.endpoint}</td><td>${w.generation}</td></tr>`).join('')}catch(e){console.error(e)}}refresh();setInterval(refresh,2000);
</script></body></html>)HTML";
}

