{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name":"dev","generator":"Ninja","binaryDir":"${sourceDir}/build/dev","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug","OGL_BUILD_TESTS":"ON"}},
    {"name":"release","generator":"Ninja","binaryDir":"${sourceDir}/build/release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release","OGL_BUILD_TESTS":"ON"}}
  ],
  "buildPresets": [
    {"name":"dev","configurePreset":"dev"},
    {"name":"release","configurePreset":"release"}
  ],
  "testPresets": [
    {"name":"dev","configurePreset":"dev","output":{"outputOnFailure":true}},
    {"name":"release","configurePreset":"release","output":{"outputOnFailure":true}}
  ]
}
